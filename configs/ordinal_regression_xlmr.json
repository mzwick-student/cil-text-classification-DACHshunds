{
  "name": "ordinal_regression_xlmr",
  "seeds": [1, 2, 3],
  "trainer": "default",
  "model": {
    "kind": "lora_bert",
    "name": "xlm-roberta-base",
    "geometry": "default",
    "lora_r": 64,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "hub_model_id": "MichaHenh/cil-ordinal-regression-seed{seed}"
  },
  "objective": {
    "name": "regression",
    "decoder": "tuned_thresholds",
    "loss": "huber"
  },
  "training": {
    "batch_size": 64,
    "eval_batch_size": 1024,
    "learning_rate": 1.5e-4,
    "scheduler": "cosine",
    "epochs": 3,
    "logging_steps": 500,
    "eval_steps": 500
  },
  "data": {
    "train": "data/train_lang.csv"
  },
  "logging": {
    "wandb_project": "cil-sentiment"
  }
}
