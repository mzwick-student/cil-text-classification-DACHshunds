{
  "name": "noise_weight_q5_xlmr_large",
  "seeds": [1],
  "trainer": "default",
  "model": {
    "kind": "lora_bert",
    "name": "xlm-roberta-large",
    "geometry": "default",
    "lora_r": 64,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "hub_model_id": "MichaHenh/cil-noise-weight-q5-xlmr-large-seed{seed}"
  },
  "objective": {
    "name": "classification",
    "decoder": "bayes_mae"
  },
  "noise_weighting": {
    "enabled": true,
    "oof_n_splits": 3,
    "oof_epochs": 1.0,
    "q_percent": 5.0,
    "noisy_weight": 0.5,
    "score": "bayes_abs_error_then_ce"
  },
  "training": {
    "batch_size": 64,
    "eval_batch_size": 1024,
    "learning_rate": 1.5e-4,
    "scheduler": "cosine",
    "epochs": 3,
    "logging_steps": 500,
    "eval_steps": 500
  },
  "data": {
    "train": "data/train_lang.csv"
  },
  "logging": {
    "wandb_project": "cil-sentiment"
  }
}
